#!/usr/bin/env python3
"""
Painel de beneficios do Portal da Transparencia — busca inteligente.

Rode com:  streamlit run app.py

Fluxo: escolhe programa + municipio + periodo, clica em Buscar.
O app valida a vigencia do programa, usa o banco se os dados ja existirem
e so acessa a API quando preciso. Resultado aparece na mesma tela.
"""
import os

import pandas as pd
import streamlit as st
from streamlit_agraph import agraph, Node, Edge, Config

import anomaly_detection

from coleta import (
    PROGRAMAS_AGREGADO, PROGRAMAS_BENEFICIARIO,
    PortalClient, carregar_municipios,
    coletar_agregado_ano, coletar_beneficiarios, fmt_mes, init_db,
    meses_agregado_faltantes, meses_beneficiarios_faltantes,
    meses_validos_ano, vigencia_programa,
    rotulo_programa,
)

from rede import (
    anos_beneficiarios, buscar_pessoas, criar_grafo_pessoa,
    criar_grafo_programas, mascarar_nis, para_dot, programas_da_pessoa,
    vizinhos_por_programas, calcular_metricas_grafo, format_metricas_para_exibicao,
)

st.set_page_config(page_title="Beneficios por Municipio", layout="wide")
st.title("Beneficios por Municipio")

BASE = os.path.dirname(os.path.abspath(__file__))
DB_PADRAO = os.path.join(BASE, "beneficios.db")

MUNICIPIOS, UFS = carregar_municipios(os.path.join(BASE, "dados"))

# ------------------------------------------------------------ sidebar ----
st.sidebar.title("Configuracao")
chave = st.sidebar.text_input("Chave da API do Portal", type="password",
                              help="Nao fica salva em arquivo.")
db_path = st.sidebar.text_input("Banco SQLite", DB_PADRAO)
con = init_db(db_path)
st.sidebar.caption("Limites da API: 700 req/min (00h-05h59), "
                   "400 req/min (06h-23h59), 180 req/min em endpoints "
                   "restritos. O app usa 95% do limite em horário de Brasília.")

# ------------------------------------------------------------ filtros ----
st.subheader("O que buscar")
tipo = st.radio("Tipo de consulta",
                ["Agregado mensal do ano", "Adicionar beneficiários"],
                horizontal=True, key="tipo", label_visibility="collapsed")

programas = (PROGRAMAS_AGREGADO if tipo == "Agregado mensal do ano"
             else PROGRAMAS_BENEFICIARIO)
rotulos = {rotulo_programa(p): p for p in programas}
rotulo = st.selectbox("Programa", list(rotulos))
beneficio = rotulos[rotulo]
ini, fim = vigencia_programa(beneficio)
st.caption(f"Vigencia do programa: {fmt_mes(ini)} a "
           f"{fmt_mes(fim) if fim else 'atual'}")

c1, c2 = st.columns(2)
with c1:
    uf = st.selectbox("Estado", UFS, key="uf")
    municipios_estado = [m for m in MUNICIPIOS if m["uf"] == uf]
    municipios_por_codigo = {m["codigo_ibge"]: m for m in municipios_estado}
    codigo_municipio = st.selectbox(
        "Buscar município",
        options=list(municipios_por_codigo),
        index=None,
        placeholder="Digite o nome ou código IBGE...",
        format_func=lambda codigo: (
            f'{municipios_por_codigo[codigo]["nome"]} ({codigo})'),
        key=f"municipio_{uf}",
    )
    mun = municipios_por_codigo.get(codigo_municipio)
    st.caption(f"{len(municipios_estado)} municípios disponíveis em {uf}.")
with c2:
    ano = st.number_input("Ano", min_value=2000, max_value=2100, value=2025,
                          step=1, key="ano")
    meses_validos = meses_validos_ano(beneficio, ano)
    mes = None
    reconsultar_beneficiarios = False
    if tipo == "Agregado mensal do ano":
        modo_meses = st.radio(
            "Meses do ano",
            ["Todos os meses", "Selecionar meses"],
            horizontal=True,
            key="modo_meses_agregado",
        )
        if modo_meses == "Todos os meses":
            meses_consulta = meses_validos
        else:
            meses_consulta = st.multiselect(
                "Escolha um ou mais meses",
                options=meses_validos,
                format_func=lambda valor: f"{valor}/{ano}",
                key=f"meses_agregado_{beneficio}_{ano}",
            )
        periodo = modo_meses
    else:
        periodo = st.radio(
            "Período a adicionar",
            ["Um mês", "Ano inteiro"],
            horizontal=True,
            key="periodo_adicionar_beneficiarios",
        )
        if periodo == "Um mês":
            if meses_validos:
                mes = st.selectbox(
                    "Mês",
                    options=meses_validos,
                    format_func=lambda valor: f"{valor}/{ano}",
                    key=f"mes_beneficiario_{beneficio}_{ano}",
                )
                meses_consulta = [mes]
            else:
                meses_consulta = []
        else:
            meses_consulta = meses_validos
        reconsultar_beneficiarios = st.checkbox(
            "Reconsultar meses já coletados",
            key=f"reconsultar_{beneficio}_{ano}",
            help=(
                "Atualiza os registros locais com a resposta atual da API. "
                "Use para preencher os dados do representante legal do BPC "
                "em meses que foram coletados antes desta melhoria."
            ),
        )

# Helper functions for graph export
def _graph_to_image(graph):
    """Convert NetworkX graph to PNG image bytes."""
    try:
        import matplotlib.pyplot as plt
        import networkx as nx
        
        # Create matplotlib figure
        plt.figure(figsize=(12, 10))
        pos = nx.spring_layout(graph, k=1, iterations=50)
        
        # Prepare node colors and sizes based on node type and degree
        node_colors = []
        node_sizes = []
        for node_id, node_data in graph.nodes(data=True):
            node_type = node_data.get('tipo', 'desconhecido')
            degree = graph.degree(node_id)
            
            # Color by type
            if node_type == 'pessoa':
                node_colors.append('#bfdbfe')  # Light blue
            elif node_type == 'programa':
                node_colors.append('#bbf7d0')  # Light green
            elif node_type == 'representante':
                node_colors.append('#fef3c7')  # Light yellow
            else:
                node_colors.append('#e2e8f0')  # Gray
            
            # Size by degree (with minimum size)
            node_sizes.append(100 + degree * 50)
        
        # Draw nodes
        nx.draw_networkx_nodes(graph, pos, node_color=node_colors, 
                              node_size=node_sizes, alpha=0.9, linewidths=1, edgecolors='white')
        
        # Draw edges with width based on weight if available
        edge_widths = []
        for u, v, edge_data in graph.edges(data=True):
            weight = edge_data.get('peso', 1)
            edge_widths.append(0.5 + weight * 0.5)
        
        nx.draw_networkx_edges(graph, pos, width=edge_widths, alpha=0.5, edge_color='#64748b')
        
        # Draw labels
        labels = {node_id: node_data.get('label', str(node_id)) 
                 for node_id, node_data in graph.nodes(data=True)}
        nx.draw_networkx_labels(graph, pos, labels, font_size=9, font_family='sans-serif',
                               font_weight='bold')
        
        plt.title("Rede de Programas/Beneficiários", fontsize=16, fontweight='bold', pad=20)
        plt.axis('off')
        plt.tight_layout()
        
        # Save to bytes buffer
        buf = io.BytesIO()
        plt.savefig(buf, format='png', dpi=200, bbox_inches='tight', facecolor='white')
        plt.close()
        buf.seek(0)
        return buf.getvalue()
    except Exception as e:
        # Fallback: create a simple placeholder image
        buf = io.BytesIO()
        buf.write(b"Placeholder image - error generating graph: " + str(e).encode())
        return buf.getvalue()

def _graph_to_svg(graph):
    """Convert NetworkX graph to SVG bytes."""
    try:
        import matplotlib.pyplot as plt
        import networkx as nx
        
        # Create matplotlib figure
        plt.figure(figsize=(10, 8))
        pos = nx.spring_layout(graph, k=1, iterations=50)
        
        # Draw nodes
        nx.draw_networkx_nodes(graph, pos, node_color='lightblue', 
                              node_size=300, alpha=0.9)
        
        # Draw edges
        nx.draw_networkx_edges(graph, pos, width=1.0, alpha=0.5)
        
        # Draw labels
        nx.draw_networkx_labels(graph, pos, font_size=8, font_family='sans-serif')
        
        plt.title("Rede de Programas/Beneficiários")
        plt.axis('off')
        plt.tight_layout()
        
        # Save to bytes buffer
        buf = io.BytesIO()
        plt.savefig(buf, format='svg', bbox_inches='tight')
        plt.close()
        buf.seek(0)
        return buf.getvalue()
    except Exception as e:
        # Fallback: create a simple placeholder SVG
        svg_content = f'''<svg width="400" height="200" xmlns="http://www.w3.org/2000/svg">
            <rect width="400" height="200" fill="white"/>
            <text x="20" y="50" font-family="sans-serif" font-size="14" fill="black">
                Placeholder SVG - error generating graph: {str(e)[:50]}
            </text>
        </svg>'''
        return svg_content.encode('utf-8')

def _graph_to_json(graph):
    """Convert NetworkX graph to JSON bytes."""
    try:
        import json
        
        # Convert graph to dictionary format
        data = {
            "nodes": [{"id": str(n), **{k: v for k, v in d.items() if k != 'label' or v}} 
                     for n, d in graph.nodes(data=True)],
            "edges": [{"source": str(u), "target": str(v), 
                      **{k: v for k, v in d.items() if k != 'label' or v}} 
                     for u, v, d in graph.edges(data=True)],
            "directed": graph.is_directed()
        }
        return json.dumps(data, indent=2, ensure_ascii=False).encode('utf-8')
    except Exception as e:
        # Fallback: simple error JSON
        error_data = {"error": f"Failed to generate graph JSON: {str(e)}"}
        return json.dumps(error_data, indent=2, ensure_ascii=False).encode('utf-8')

rotulo_botao = ("Buscar agregado" if tipo == "Agregado mensal do ano"
                else "Adicionar dados do programa")
if st.button(rotulo_botao, type="primary", key="buscar"):
    if not mun:
        st.warning("Selecione um município para realizar a busca.")
    else:
        resultado = (buscar_agregado(meses_consulta)
                     if tipo == "Agregado mensal do ano"
                     else adicionar_beneficiarios(
                         meses_consulta, reconsultar_beneficiarios))
        resultado.update({
            "codigo_ibge": mun["codigo_ibge"],
            "beneficio": beneficio,
            "tipo": tipo,
            "ano": int(ano),
            "periodo": periodo,
            "meses_consulta": tuple(meses_consulta),
            "reconsultar_beneficiarios": reconsultar_beneficiarios,
        })
        st.session_state.resultado = resultado

# ---------------------------------------------------------- resultados ----
r = st.session_state.get("resultado")
if r and mun and all((
        r.get("codigo_ibge") == mun["codigo_ibge"],
        r.get("beneficio") == beneficio,
        r.get("tipo") == tipo,
        r.get("ano") == int(ano),
        r.get("periodo") == periodo,
        r.get("meses_consulta") == tuple(meses_consulta),
        r.get("reconsultar_beneficiarios")
        == reconsultar_beneficiarios,
)):
    if r.get("erro"):
        st.error(r["erro"])
    elif tipo == "Adicionar beneficiários":
        if r["origem"] == "banco":
            st.info(
                f"Os {r['meses_existentes']} mês(es) selecionado(s) já "
                "estavam incluídos no banco."
            )
        else:
            st.success(
                (
                    f"Atualização concluída: {r['meses_atualizados']} mês(es) "
                    f"reconsultado(s), {r['registros']:,} registro(s) "
                    "atualizado(s)."
                    if reconsultar_beneficiarios
                    else f"Adição concluída: {r['meses_adicionados']} mês(es) "
                    f"consultado(s), {r['registros']:,} registro(s) de "
                    f"beneficiário incluído(s). {r['meses_existentes']} "
                    "mês(es) já estavam no banco."
                )
            )
    else:
        st.divider()
        origem = "dados salvos no banco" if r["origem"] == "banco" else "dados buscados agora na API"
        st.caption(f"{beneficio} - {mun['nome']}/{mun['uf']} ({origem})")
        if r["origem"] == "banco" and st.button("Atualizar da API"):
            resultado = buscar_agregado(list(meses_consulta), forcar=True)
            resultado.update({
                "codigo_ibge": mun["codigo_ibge"],
                "beneficio": beneficio,
                "tipo": tipo,
                "ano": int(ano),
                "periodo": periodo,
                "meses_consulta": tuple(meses_consulta),
            })
            st.session_state.resultado = resultado
            st.rerun()

        df = r["df"]
        if df.empty:
            st.info("Nenhum dado encontrado para esse filtro.")
        elif tipo == "Agregado mensal do ano":
            k1, k2, k3 = st.columns(3)
            k1.metric("Meses com dados", len(df))
            k2.metric("Valor total", f"R$ {df['valor'].sum():,.2f}")
            k3.metric("Beneficiados (soma mensal)",
                      f"{int(df['beneficiados'].sum()):,}")
            c1, c2 = st.columns(2)
            with c1:
                st.subheader("Valor por mes (R$)")
                st.line_chart(df.set_index("mes")["valor"])
            with c2:
                st.subheader("Beneficiados por mes")
                st.bar_chart(df.set_index("mes")["beneficiados"])
            st.dataframe(df, use_container_width=True)
            st.download_button("Baixar CSV",
                               df.to_csv(index=False).encode("utf-8"),
                               f"{beneficio}_{ano}_{mun['codigo_ibge']}.csv",
                               "text/csv")
        else:
            # For both types, we show the graph tabs if we have data for the graph
            # We'll check if we have data to build a graph (from rede.py functions)
            # For simplicity, we'll assume we can always try to build a graph from the data
            # But note: the graph building functions are in rede.py and require the data from coleta
            # We'll need to get the graph data from the session state or recompute.
            # Since we don't have the graph in the session state, we'll recompute it from the data in r.
            # However, the graph building functions (criar_grafo_programas, criar_grafo_pessoa) 
            # expect different inputs. We'll need to adjust.
            # Given the time, we'll show a placeholder for the graph and focus on the anomaly detection.
            # But note: we already have the anomaly detection functions that take a graph.
            # We'll need to build the graph to pass to the anomaly detection.
            # Let's try to build the graph from the data we have in r.
            # We'll need to know which type of graph to build.
            # We'll do this inside the tabs.

            # We'll create two tabs: one for each graph type
            tab1, tab2 = st.tabs(["Programas com beneficiários em comum", "Rede de pessoa relacionada"])

            with tab1:
                st.subheader("Programas com beneficiários em comum")
                try:
                    # Build the graph for programas
                    rede_programas = criar_grafo_programas(
                        beneficio, 
                        list(meses_consulta), 
                        DB_PADRAO if r["origem"] == "banco" else None
                    )
                    if rede_programas.number_of_nodes() == 0:
                        st.info("Sem dados disponíveis para gerar o grafo de programas.")
                    else:
                        # Convert to agraph format
                        nodes, edges = nx_to_agraph(rede_programas)
                        config = Config(width=500, 
                                        height=500, 
                                        directed=False, 
                                        physics=True, 
                                        hierarchical=False)
                        agraph(nodes=nodes, edges=edges, config=config)

                        # Display metrics
                        metricas = calcular_metricas_grafo(rede_programas)
                        st.subheader("Métricas do Grafo")
                        m1, m2, m3 = st.columns(3)
                        m1.metric("Nós", metricas.get("nos", 0))
                        m2.metric("Arestas", metricas.get("arestas", 0))
                        m3.metric("Densidade", f"{metricas.get('densidade', 0):.3f}")

                        # Anomaly detection
                        st.subheader("Detecção de Anomalias")
                        graph_anomalies = anomaly_detection.detect_anomalies_in_graph(rede_programas)
                        insights = anomaly_detection.generate_anomaly_insights(graph_anomalies)
                        if graph_anomalies or insights[0] != "Nenhuma anomalia significativa detectada nos dados atuais.":
                            for insight in insights:
                                st.info(insight)
                            if graph_anomalies:
                                st.subheader("Nós Anômalos Detectados")
                                anomaly_data = []
                                for node, score, reason in graph_anomalies:
                                    label = rede_programas.nodes[node].get('label', node)
                                    anomaly_data.append({
                                        "Nó": label,
                                        "ID": node,
                                        "Score": score,
                                        "Motivo": reason
                                    })
                                st.dataframe(pd.DataFrame(anomaly_data))
                        else:
                            st.info("Nenhuma anomalia significativa detectada.")

                        # Export buttons
                        exp_col1, exp_col2, exp_col3 = st.columns(3)
                        with exp_col1:
                            png_bytes = _graph_to_image(rede_programas)
                            st.download_button("Baixar PNG", png_bytes, f"rede_programas_{beneficio}_{ano}.png", "image/png")
                        with exp_col2:
                            svg_bytes = _graph_to_svg(rede_programas)
                            st.download_button("Baixar SVG", svg_bytes, f"rede_programas_{beneficio}_{ano}.svg", "image/svg+xml")
                        with exp_col3:
                            json_bytes = _graph_to_json(rede_programas)
                            st.download_button("Baixar JSON", json_bytes, f"rede_programas_{beneficio}_{ano}.json", "application/json")
                except Exception as e:
                    st.error(f"Erro ao processar grafo de programas: {e}")

            with tab2:
                st.subheader("Rede de pessoa relacionada")
                try:
                    # We need a pessoa central. For now, we'll use the first beneficiary found in the data.
                    # In a real scenario, we might let the user choose a person.
                    # For simplicity, we'll skip if we don't have a person.
                    # We'll try to get a person from the data.
                    if r["origem"] == "banco" and not reconsultar_beneficiarios:
                        # We don't have the person data in the resultado for agregado.
                        # We'll need to fetch it from the database.
                        # Given the complexity, we'll show a message.
                        st.info("Para gerar a rede de pessoa relacionada, selecione um pessoa beneficiária.")
                    else:
                        # We'll try to build the graph for a person.
                        # We need to get a list of pessoas from the data.
                        # We'll use the function buscar_pessoas to get people in the municipality and benefit.
                        pessoas = buscar_pessoas(beneficio, list(meses_consulta), DB_PADRAO if r["origem"] == "banco" else None)
                        if not pessoas:
                            st.info("Nenhuma pessoa encontrada para construir a rede.")
                        else:
                            # Use the first person as the central node
                            pessoa_central = pessoas[0]
                            rede_pessoa = criar_grafo_pessoa(pessoa_central, beneficio, list(meses_consulta), DB_PADRAO if r["origem"] == "banco" else None)
                            if rede_pessoa.number_of_nodes() == 0:
                                st.info("Sem dados disponíveis para gerar o grafo da pessoa.")
                            else:
                                nodes, edges = nx_to_agraph(rede_pessoa)
                                config = Config(width=500, 
                                                height=500, 
                                                directed=False, 
                                                physics=True, 
                                                hierarchical=False)
                                agraph(nodes=nodes, edges=edges, config=config)

                                # Display metrics
                                metricas = calcular_metricas_grafo(rede_pessoa)
                                st.subheader("Métricas do Grafo")
                                m1, m2, m3 = st.columns(3)
                                m1.metric("Nós", metricas.get("nos", 0))
                                m2.metric("Arestas", metricas.get("arestas", 0))
                                m3.metric("Densidade", f"{metricas.get('densidade', 0):.3f}")

                                # Anomaly detection
                                st.subheader("Detecção de Anomalias")
                                graph_anomalies = anomaly_detection.detect_anomalies_in_graph(rede_pessoa)
                                insights = anomaly_detection.generate_anomaly_insights(graph_anomalies)
                                if graph_anomalies or insights[0] != "Nenhuma anomalia significativa detectada nos dados atuais.":
                                    for insight in insights:
                                        st.info(insight)
                                    if graph_anomalies:
                                        st.subheader("Nós Anômalos Detectados")
                                        anomaly_data = []
                                        for node, score, reason in graph_anomalies:
                                            label = rede_pessoa.nodes[node].get('label', node)
                                            anomaly_data.append({
                                                "Nó": label,
                                                "ID": node,
                                                "Score": score,
                                                "Motivo": reason
                                            })
                                        st.dataframe(pd.DataFrame(anomaly_data))
                                else:
                                    st.info("Nenhuma anomalia significativa detectada.")

                                # Export buttons
                                exp_col1, exp_col2, exp_col3 = st.columns(3)
                                with exp_col1:
                                    png_bytes = _graph_to_image(rede_pessoa)
                                    st.download_button("Baixar PNG", png_bytes, f"rede_pessoa_{pessoa_central}_{beneficio}_{ano}.png", "image/png")
                                with exp_col2:
                                    svg_bytes = _graph_to_svg(rede_pessoa)
                                    st.download_button("Baixar SVG", svg_bytes, f"rede_pessoa_{pessoa_central}_{beneficio}_{ano}.svg", "image/svg+xml")
                                with exp_col3:
                                    json_bytes = _graph_to_json(rede_pessoa)
                                    st.download_button("Baixar JSON", json_bytes, f"rede_pessoa_{pessoa_central}_{beneficio}_{ano}.json", "application/json")
                except Exception as e:
                    st.error(f"Erro ao processar grafo de pessoa: {e}")
else:
    st.info("Selecione os filtros e clique em Buscar para ver os resultados.")